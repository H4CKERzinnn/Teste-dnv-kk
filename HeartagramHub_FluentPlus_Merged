TPSection:AddButton({
    Title = "Map TP",
    Callback = function()
        local map
        for _, v in pairs(workspace:GetChildren()) do
            if v:GetAttribute("MapID") then map = v break end
        end
        if map and map:FindFirstChild("Spawns") then
            for _, spawn in pairs(map.Spawns:GetChildren()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    p.Character.HumanoidRootPart.CFrame = spawn.CFrame
                    return
                end
            end
        end
    end
})

TPSection:AddButton({
    Title = "Lobby TP",
    Callback = function()
        if workspace:FindFirstChild("RegularLobby") and workspace.RegularLobby:FindFirstChild("Spawns") then
            for _, spawn in pairs(workspace.RegularLobby.Spawns:GetChildren()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
