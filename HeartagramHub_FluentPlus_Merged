local function setupCharacterCollision(char)
    local function disableCollide(part)
        if isafEnabled and part:IsA('BasePart') then
            part.CanCollide = false
        end
    end
    for _, v in ipairs(char:GetChildren()) do disableCollide(v) end
    local conn1 = char.ChildAdded:Connect(disableCollide)
    local conn2 = RunService.Stepped:Connect(function()
        if isafEnabled and char:IsDescendantOf(workspace) then
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA('BasePart') and v.CanCollide then v.CanCollide = false end
            end
        end
    end)
    char.Destroying:Connect(function()
        conn1:Disconnect()
        conn2:Disconnect()
    end)
end

local function trackPlayer(plr)
    if plr == p then return end
    plr.CharacterAdded:Connect(setupCharacterCollision)
    if plr.Character then setupCharacterCollision(plr.Character) end
end
for _, plr in ipairs(Players:GetPlayers()) do trackPlayer(plr) end
Players.PlayerAdded:Connect(trackPlayer)

local function getPlayerList()
