-- FOUR HUB MINI | Fling Player + Anti-Fling
-- Interface FluentPlus; a lista do dropdown acompanha entradas e saídas do servidor.

if _G.FourHubMiniLoaded then
    return
end
_G.FourHubMiniLoaded = true

local Players = game:GetService('Players')
local RunService = game:GetService('RunService')
local LocalPlayer = Players.LocalPlayer

local loaded, Fluent, SaveManager, InterfaceManager, IsMobile = pcall(function()
    return loadstring(game:HttpGet('https://raw.githubusercontent.com/discoart/FluentPlus/refs/heads/main/Beta.lua'))()
end)

if not loaded or not Fluent then
    _G.FourHubMiniLoaded = nil
    return
end

local Window = Fluent:CreateWindow({
    Title = 'FOUR HUB MINI',
    SubTitle = 'Fling Player • Anti-Fling',
    Theme = 'Dark',
    Size = UDim2.fromOffset(430, 300),
    TabWidth = 145,
    Acrylic = true,
    MinimizeKey = Enum.KeyCode.LeftAlt,
})

local FlingActive = false
local AntiFlingEnabled = false
local SelectedTarget = nil
local PlayerDropdown = nil
local OriginalCollision = {}
local AntiFlingInitialized = false

local function notify(title, content, duration)
    Fluent:Notify({
        Title = title,
        Content = content,
        Duration = duration or 3,
    })
end

local function getPlayerNames()
    local names = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(names, player.Name)
        end
    end
    table.sort(names)
    if #names == 0 then
        return { 'No players' }
    end
    return names
end

local function refreshPlayerDropdown()
    if PlayerDropdown then
        PlayerDropdown:SetValues(getPlayerNames())
    end
end

local function restoreCollisions()
    for part, canCollide in pairs(OriginalCollision) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = canCollide
            end)
        end
        OriginalCollision[part] = nil
    end
end

local function enforceAntiFling()
    if not AntiFlingEnabled then
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, item in ipairs(player.Character:GetDescendants()) do
                if item:IsA('BasePart') then
                    if OriginalCollision[item] == nil then
                        OriginalCollision[item] = item.CanCollide
                    end
                    if item.CanCollide then
                        item.CanCollide = false
                    end
                end
            end
        end
    end
end

local lastAntiFlingCheck = 0
local antiFlingHeartbeat = RunService.Heartbeat:Connect(function()
    if AntiFlingEnabled and os.clock() - lastAntiFlingCheck >= 0.15 then
        lastAntiFlingCheck = os.clock()
        enforceAntiFling()
    end
end)

local function setAntiFling(enabled)
    local wasInitialized = AntiFlingInitialized
    AntiFlingInitialized = true
    AntiFlingEnabled = enabled == true
    if AntiFlingEnabled then
        enforceAntiFling()
        if wasInitialized then
            notify('Anti-Fling ligado', 'Colisões dos outros personagens serão desativadas localmente.', 3)
        end
    else
        restoreCollisions()
        if wasInitialized then
            notify('Anti-Fling desligado', 'As colisões locais foram restauradas.', 3)
        end
    end
end

local function runFling(target)
    if FlingActive then
        notify('Fling em andamento', 'Pare o fling atual antes de iniciar outro.', 3)
        return
    end
    if not target or target == LocalPlayer or target.Parent ~= Players then
        notify('Selecione um jogador', 'Escolha um nome no dropdown primeiro.', 3)
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass('Humanoid')
    local root = humanoid and humanoid.RootPart
    local targetCharacter = target.Character
    local targetHumanoid = targetCharacter and targetCharacter:FindFirstChildOfClass('Humanoid')
    local targetPart = targetHumanoid and targetHumanoid.RootPart
        or (targetCharacter and (targetCharacter:FindFirstChild('HumanoidRootPart') or targetCharacter:FindFirstChild('Head')))

    if not character or not humanoid or not root or not targetCharacter or not targetPart then
        notify('Não foi possível iniciar', 'Um dos personagens ainda não está carregado.', 3)
        return
    end
    if targetHumanoid and targetHumanoid.Sit then
        notify('Alvo sentado', 'O fling pode não funcionar enquanto o alvo estiver sentado.', 3)
        return
    end

    FlingActive = true
    local originalPivot = character:GetPivot()
    local originalFallenHeight = workspace.FallenPartsDestroyHeight
    local seatedStateEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Seated)
    local camera = workspace.CurrentCamera
    local startedAt = os.clock()

    notify('Fling iniciado', 'Tentando lançar ' .. target.Name .. '.', 3)

    local ok, err = pcall(function()
        -- Este ajuste é temporário e é restaurado mesmo se a rotina falhar.
        pcall(function()
            workspace.FallenPartsDestroyHeight = 0 / 0
        end)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if camera then
            camera.CameraSubject = targetPart
        end

        local spin = 0
        while FlingActive and os.clock() - startedAt < 2 do
            if not root.Parent or not targetPart.Parent then
                break
            end
            spin = spin + 100
            local targetPosition = targetPart.Position
            local verticalOffset = (spin % 2 == 0) and 1.5 or -1.5
            local destination = CFrame.new(targetPosition)
                * CFrame.new(0, verticalOffset, 0)
                * CFrame.Angles(math.rad(spin), 0, 0)

            character:PivotTo(destination)
            root.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            root.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            RunService.Heartbeat:Wait()
        end
    end)

    FlingActive = false
    pcall(function()
        workspace.FallenPartsDestroyHeight = originalFallenHeight
    end)
    pcall(function()
        if humanoid.Parent then
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, seatedStateEnabled)
        end
        if character.Parent and root.Parent then
            character:PivotTo(originalPivot)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if camera and humanoid.Parent then
            camera.CameraSubject = humanoid
        end
    end)

    if not ok then
        notify('Fling interrompido', tostring(err), 4)
    else
        notify('Fling finalizado', 'A física do servidor pode impedir o efeito.', 3)
    end
end

local MainTab = Window:AddTab({
    Title = 'Player',
    Icon = 'users',
})
local MainSection = MainTab:AddSection('Controles')

PlayerDropdown = MainSection:AddDropdown('FlingTarget', {
    Title = 'Selecionar jogador',
    Description = 'Lista automática dos jogadores neste servidor',
    Values = getPlayerNames(),
    Default = nil,
    AllowNull = true,
    Callback = function(name)
        if type(name) == 'string' and name ~= 'No players' then
            SelectedTarget = Players:FindFirstChild(name)
        else
            SelectedTarget = nil
        end
    end,
})

MainSection:AddButton({
    Title = 'Fling Player',
    Description = 'Tenta lançar o jogador selecionado',
    Callback = function()
        runFling(SelectedTarget)
    end,
})

MainSection:AddButton({
    Title = 'Parar Fling',
    Description = 'Interrompe a tentativa atual',
    Callback = function()
        if FlingActive then
            FlingActive = false
            notify('Fling parado', 'A rotina foi interrompida.', 2)
        else
            notify('Nenhum fling ativo', 'Não há rotina para parar.', 2)
        end
    end,
})

MainSection:AddToggle('AntiFling', {
    Title = 'Anti-Fling',
    Description = 'Desativa colisões dos outros personagens localmente',
    Default = false,
    Callback = setAntiFling,
})

Players.PlayerAdded:Connect(function()
    task.defer(refreshPlayerDropdown)
end)

Players.PlayerRemoving:Connect(function(player)
    if SelectedTarget == player then
        SelectedTarget = nil
        if PlayerDropdown then
            PlayerDropdown:SetValue(nil)
        end
    end
    task.defer(refreshPlayerDropdown)
end)

if IsMobile then
    pcall(function()
        Fluent:CreateMinimizer({
            Position = UDim2.new(1, -58, 0, 86),
            Size = UDim2.fromOffset(46, 46),
            Draggable = true,
            Visible = true,
        })
    end)
end

Window.Root.Destroying:Connect(function()
    FlingActive = false
    AntiFlingEnabled = false
    restoreCollisions()
    if antiFlingHeartbeat.Connected then
        antiFlingHeartbeat:Disconnect()
    end
    _G.FourHubMiniLoaded = nil
end)
